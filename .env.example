# ============================================================================
# Real-Time Distributed Enterprise SIEM Engine — example environment
# Copy to `.env` (never commit `.env`).  All values below are safe local
# development defaults.  Change every secret before any non-local use.
# ============================================================================

# --- Core ---
SIEM_ENV=development                # development | production
SIEM_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
SIEM_LOG_JSON=true                  # structured JSON logs

# --- API ---
SIEM_API_HOST=0.0.0.0
SIEM_API_PORT=8000
SIEM_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SIEM_RATE_LIMIT_PER_MINUTE=240      # per-client request budget for /api/*

# --- PostgreSQL ---
POSTGRES_USER=siem
POSTGRES_PASSWORD=siem_dev_password_change_me
POSTGRES_DB=siem
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL is derived from the parts above by app.core.config; override if needed:
# SIEM_DATABASE_URL=postgresql+asyncpg://siem:siem_dev_password_change_me@postgres:5432/siem

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# SIEM_REDIS_URL=redis://redis:6379/0

# --- Redpanda / Kafka ---
SIEM_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
SIEM_KAFKA_TOPIC_EVENTS=siem.events.raw
SIEM_KAFKA_CONSUMER_GROUP=siem-stream-processor
SIEM_KAFKA_CLIENT_ID=siem

# --- Detection thresholds (override rule defaults) ---
SIEM_RULE_BRUTEFORCE_MAX_FAILURES=10
SIEM_RULE_BRUTEFORCE_WINDOW_SECONDS=60
SIEM_RULE_PORTSCAN_UNIQUE_PORTS=20
SIEM_RULE_PORTSCAN_WINDOW_SECONDS=30
SIEM_RULE_SPRAY_UNIQUE_USERS=8
SIEM_RULE_SPRAY_WINDOW_SECONDS=120
SIEM_RULE_EXFIL_BYTES_THRESHOLD=52428800   # 50 MiB outbound in window
SIEM_RULE_EXFIL_WINDOW_SECONDS=60

# --- Anomaly detection ---
SIEM_ANOMALY_ZSCORE_THRESHOLD=3.5
SIEM_ANOMALY_EWMA_ALPHA=0.3
SIEM_ANOMALY_MIN_SAMPLES=20

# --- Optional ML layer (Isolation Forest). Off by default. ---
SIEM_ENABLE_ML=false

# --- Optional threat-intel enrichment. Synthetic provider by default. ---
SIEM_ENRICHMENT_PROVIDER=synthetic     # synthetic | none
# No API keys are required to run this project.

# --- Optional LLM alert assistant. Off by default; core SIEM never needs it. ---
SIEM_ENABLE_LLM_ASSIST=false
# ANTHROPIC_API_KEY=            # only if SIEM_ENABLE_LLM_ASSIST=true

# --- Optional dashboard auth (development seed only) ---
SIEM_AUTH_ENABLED=false
SIEM_JWT_SECRET=dev_only_insecure_secret_change_me
SIEM_JWT_EXPIRE_MINUTES=60
SIEM_SEED_ADMIN_USERNAME=admin
SIEM_SEED_ADMIN_PASSWORD=admin_dev_only_change_me

# --- Simulator ---
SIEM_EVENTS_PER_SECOND=60
SIEM_SIMULATOR_SCENARIO=mixed          # normal | ssh_brute_force | port_scan | credential_attack | privilege_escalation | data_exfiltration | web_attack | mixed
SIEM_SIMULATOR_ATTACK_RATIO=0.06       # fraction of traffic that is malicious in `mixed`
SIEM_SIMULATOR_AUTOSTART=false         # start generating on container boot

# --- Observability ---
SIEM_WORKER_METRICS_PORT=9109          # stream processor Prometheus endpoint

# --- Frontend (build-time) ---
# Empty base => same-origin (nginx in the frontend image proxies /api and /ws).
VITE_API_BASE_URL=
VITE_WS_URL=/ws
